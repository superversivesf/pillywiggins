services:
  postgres:
    image: pgvector/pgvector:pg16
    environment:
      POSTGRES_DB: pillywiggins
      POSTGRES_USER: pillywiggins
      POSTGRES_PASSWORD: ${PG_PASSWORD:-changeme}
    volumes:
    - pgdata:/var/lib/postgresql/data
    - ./scripts/init-db.sql:/docker-entrypoint-initdb.d/01-schema.sql:ro
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 512M
    healthcheck:
      test:
      - CMD-SHELL
      - pg_isready -U pillywiggins
      interval: 5s
      timeout: 5s
      retries: 5
    ports:
    - 127.0.0.1:5432:5432
    networks:
    - pillywiggins
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: redis-server --appendonly yes
    tmpfs:
    - /tmp
    volumes:
    - redisdata:/data
    deploy:
      resources:
        limits:
          memory: 256M
    ports:
    - 127.0.0.1:6379:6379
    healthcheck:
      test:
      - CMD
      - redis-cli
      - ping
      interval: 5s
      timeout: 3s
      retries: 5
    networks:
    - pillywiggins
  nats:
    image: nats:2-alpine
    restart: unless-stopped
    cap_drop:
    - ALL
    read_only: true
    security_opt:
    - no-new-privileges:true
    tmpfs:
    - /tmp
    command: nats-server -js -m 8222
    deploy:
      resources:
        limits:
          memory: 256M
    ports:
    - 127.0.0.1:4222:4222
    - 127.0.0.1:8222:8222
    healthcheck:
      test:
      - CMD
      - wget
      - --spider
      - -q
      - http://localhost:8222/healthz
      interval: 10s
      timeout: 3s
      retries: 5
    networks:
    - pillywiggins
  searxng:
    image: searxng/searxng:latest
    restart: unless-stopped
    cap_drop:
    - ALL
    read_only: true
    security_opt:
    - no-new-privileges:true
    tmpfs:
    - /tmp
    environment:
      SEARXNG_BASE_URL: http://searxng:8080/
      SEARXNG_SECRET: ${SEARXNG_SECRET:-}
    volumes:
    - searxng_data:/etc/searxng:rw
    - ./searxng_settings.yml:/etc/searxng/settings.yml
    deploy:
      resources:
        limits:
          memory: 512M
    ports:
    - 127.0.0.1:8888:8080
    healthcheck:
      test:
      - CMD
      - wget
      - --spider
      - -q
      - http://localhost:8080/healthz
      interval: 10s
      timeout: 5s
      retries: 10
    networks:
    - pillywiggins

  # # Uncomment and customize to add an agent. Use `pillywiggins onboard`
  # # to generate your agent config. Copy this block once per agent
  # # and set a unique service name, AGENT_ID, and personality file.
  # agent:
  #   build: .
  #   restart: unless-stopped
  #   cap_drop:
  #   - ALL
  #   read_only: true
  #   security_opt:
  #   - no-new-privileges:true
  #   tmpfs:
  #   - /tmp
  #   - /app/logs
  #   deploy:
  #     resources:
  #       limits:
  #         memory: 512M
  #   command: python -m pillywiggins --agent-id agent
  #   env_file:
  #   - .env
  #   environment:
  #     AGENT_ID: agent
  #     PERSONALITY_FILE: /config/agent.yaml
  #     # TELEGRAM_BOT_TOKEN: ${AGENT_TELEGRAM_TOKEN}   # uncomment for Telegram
  #     # SLACK_BOT_TOKEN: ${AGENT_SLACK_TOKEN}         # uncomment for Slack
  #   volumes:
  #   - ./personalities:/config:ro
  #   - ./agents.yaml:/app/agents.yaml:ro
  #   - ./skills:/app/skills
  #   healthcheck:
  #     test:
  #     - CMD-SHELL
  #     - pgrep -f 'pillywiggins --agent-id' || exit 1
  #     interval: 10s
  #     timeout: 5s
  #     retries: 3
  #     start_period: 30s
  #   depends_on:
  #     postgres:
  #       condition: service_healthy
  #     redis:
  #       condition: service_healthy
  #     nats:
  #       condition: service_healthy
  #   networks:
  #   - pillywiggins

networks:
  pillywiggins:
    driver: bridge
volumes:
  pgdata: null
  redisdata: null
  searxng_data: null
