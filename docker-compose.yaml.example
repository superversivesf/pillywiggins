services:
  postgres:
    image: pgvector/pgvector:pg16
    environment:
      POSTGRES_DB: pillywiggins
      POSTGRES_USER: pillywiggins
      POSTGRES_PASSWORD: ${PG_PASSWORD:-changeme}
    volumes:
    - pgdata:/var/lib/postgresql/data
    - ./scripts/init-db.sql:/docker-entrypoint-initdb.d/01-schema.sql:ro
    restart: unless-stopped
    healthcheck:
      test:
      - CMD-SHELL
      - pg_isready -U pillywiggins
      interval: 5s
      timeout: 5s
      retries: 5
    ports:
    - 5432:5432
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: redis-server --appendonly yes
    volumes:
    - redisdata:/data
    ports:
    - 6379:6379
    healthcheck:
      test:
      - CMD
      - redis-cli
      - ping
      interval: 5s
      timeout: 3s
      retries: 5
  nats:
    image: nats:2-alpine
    restart: unless-stopped
    command: nats-server -js -m 8222
    ports:
    - 4222:4222
    - 8222:8222
    healthcheck:
      test:
      - CMD
      - wget
      - --spider
      - -q
      - http://localhost:8222/healthz
      interval: 10s
      timeout: 3s
      retries: 5
  searxng:
    image: searxng/searxng:latest
    restart: unless-stopped
    environment:
      SEARXNG_BASE_URL: http://searxng:8080/
      SEARXNG_SECRET: ${SEARXNG_SECRET:-}
    volumes:
    - searxng_data:/etc/searxng:rw
    - ./searxng_settings.yml:/etc/searxng/settings.yml:ro
    ports:
    - 8888:8080
    healthcheck:
      test:
      - CMD
      - wget
      - --spider
      - -q
      - http://localhost:8080/healthz
      interval: 10s
      timeout: 5s
      retries: 10
  puck:
    build: .
    restart: unless-stopped
    command: python -m pillywiggins --agent-id puck
    env_file: .env
    extra_hosts:
    - "host.docker.internal:host-gateway"
    environment:
      AGENT_ID: puck
      TELEGRAM_BOT_TOKEN: ${PUCK_TELEGRAM_TOKEN}
      PERSONALITY_FILE: /config/puck.yaml
      HEALTH_PORT: 8080
    volumes:
    - ./personalities:/config:ro
    - ./agents.yaml:/app/agents.yaml:ro
    - skills:/app/skills
    healthcheck:
      test:
      - CMD-SHELL
      - wget --spider -q http://localhost:8080/healthz || exit 1
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 5s
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      nats:
        condition: service_healthy
      searxng:
        condition: service_healthy
  puck-discord:
    build: .
    restart: unless-stopped
    command: python -m pillywiggins --agent-id puck-discord
    env_file: .env
    extra_hosts:
    - "host.docker.internal:host-gateway"
    environment:
      AGENT_ID: puck-discord
      DISCORD_BOT_TOKEN: ${PUCK_DISCORD_TOKEN}
      HEALTH_PORT: 8080
    volumes:
    - ./personalities:/config:ro
    - ./agents.yaml:/app/agents.yaml:ro
    - skills:/app/skills
    healthcheck:
      test:
      - CMD-SHELL
      - wget --spider -q http://localhost:8080/healthz || exit 1
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 5s
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      nats:
        condition: service_healthy
volumes:
  pgdata: null
  redisdata: null
  searxng_data: null
  skills: null