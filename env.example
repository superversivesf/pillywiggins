# Pillywiggins Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- Infrastructure ---
DATABASE_URL=postgresql://pillywiggins:changeme@postgres:5432/pillywiggins
PG_PASSWORD=changeme
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

# --- LLM Provider ---
# Option A: Local/self-hosted Ollama (default, no API key needed)
# Uses host.docker.internal so Docker containers can reach Ollama on the host.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
MODEL_NAME=qwen3.5:8b

# Option B: Ollama Cloud (requires API key from ollama.com/settings/keys)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://ollama.com/v1
# LLM_API_KEY=your_ollama_api_key
# MODEL_NAME=qwen3.5:9b

# Option C: OpenAI
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_openai_api_key
# MODEL_NAME=gpt-4o-mini

# Option D: Groq (fast inference — https://console.groq.com/keys)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_api_key
# MODEL_NAME=llama-3.3-70b-versatile

# Option E: Together AI (https://api.together.ai/settings/api-keys)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_API_KEY=your_together_api_key
# MODEL_NAME=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8

# Option F: OpenRouter (https://openrouter.ai/keys)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_api_key
# MODEL_NAME=anthropic/claude-sonnet-4-5

# Option G: vLLM (self-hosted inference server)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://host.docker.internal:8000/v1
# LLM_API_KEY=
# MODEL_NAME=qwen3.5:8b

# Option H: LiteLLM Proxy (multi-provider gateway)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://host.docker.internal:4000/v1
# LLM_API_KEY=
# MODEL_NAME=gpt-4o

# Option I: Custom (any OpenAI-compatible API)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://your-api.example.com/v1
# LLM_API_KEY=your_api_key
# MODEL_NAME=your-model-name

# Use "auto" to discover an embedding model from Ollama (/api/tags),
# or set a specific model name (e.g. "nomic-embed-text", "mxbai-embed-large").
# "auto" will fall back to sentence-transformers (HuggingFace) if no Ollama embedding model is found.
EMBEDDING_MODEL=auto

# --- Telegram Bot Tokens ---
# One token per agent. Create bots via @BotFather, then paste tokens here.
PUCK_TELEGRAM_TOKEN=your_puck_telegram_bot_token_here
# Add more agents with: pillywiggins onboard

# --- Discord Bot Tokens ---
# Create bots at https://discord.com/developers/applications, then paste tokens here.
PUCK_DISCORD_TOKEN=your_discord_bot_token_here

# --- Agent Identity (defaults, overridden by agents.yaml) ---
AGENT_ID=puck
CHANNEL=telegram
PERSONALITY_FILE=/config/puck.yaml
TIMEZONE=UTC
TZ=UTC

# --- Access Control ---
# Comma-separated Telegram user IDs allowed to use the bot.
# Default: deny all. Set to "all" to allow anyone (dev mode).
# ALLOWED_USER_IDS=all
ALLOWED_USER_IDS=

# --- Compact ---
COMPACT_KEEP_MESSAGES=6
COMPACT_TRUNCATE_MESSAGE_CHARS=2000

# --- SearXNG (Web Search) ---
SEARXNG_URL=http://searxng:8080
SEARXNG_CATEGORIES=general
SEARXNG_MAX_RESULTS=5
SEARXNG_SECRET=

# --- Brave Search API (alternative web search) ---
# Get a free key at https://brave.com/search/api/
# Replaces SearXNG when configured. Free tier: ~1,000 searches/month.
BRAVE_API_KEY=

# Optional: WolframAlpha API key for computational/factual answers
# WOLFRAMALPHA_API_KEY=your_wolframalpha_api_key_here

# --- Scheduler ---
SCHEDULER_ENABLED=true

# --- Sandbox ---
SANDBOX_SKILLS=