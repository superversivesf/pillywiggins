# Pillywiggins Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- PostgreSQL ---
DATABASE_URL=postgresql://pillywiggins:changeme@postgres:5432/pillywiggins
PG_PASSWORD=changeme

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- NATS ---
NATS_URL=nats://nats:4222

# --- Ollama (external instance — set to your Ollama URL) ---
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=qwen3.5:8b
EMBEDDING_MODEL=nomic-embed-text

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Agent Identity ---
AGENT_ID=puck
CHANNEL=telegram
PERSONALITY_FILE=/config/telegram.yaml