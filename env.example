# Pillywiggins Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- PostgreSQL ---
DATABASE_URL=postgresql://pillywiggins:changeme@postgres:5432/pillywiggins
PG_PASSWORD=changeme

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- NATS ---
NATS_URL=nats://nats:4222

# --- LLM Provider ---
# Choose one of three options:
#
# Option A: Local/self-hosted Ollama (default, no API key needed)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
MODEL_NAME=qwen3.5:8b

# Option B: Ollama Cloud (requires API key from ollama.com/settings/keys)
# Uses OpenAI-compatible /v1 endpoint on ollama.com.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://ollama.com/v1
# LLM_API_KEY=your_ollama_api_key
# MODEL_NAME=qwen3.5:9b

# Option C: Any OpenAI-compatible API (OpenAI, Groq, Together, etc.)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_api_key
# MODEL_NAME=llama-3.3-70b-versatile

EMBEDDING_MODEL=nomic-embed-text

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Agent Identity ---
AGENT_ID=puck
CHANNEL=telegram
PERSONALITY_FILE=/config/telegram.yaml

# --- Access Control ---
# Comma-separated Telegram user IDs allowed to use the bot.
# Default: deny all. Set to "all" to allow anyone (dev mode).
# ALLOWED_USER_IDS=all
ALLOWED_USER_IDS=

# --- Compact ---
COMPACT_KEEP_MESSAGES=6
COMPACT_TRUNCATE_MESSAGE_CHARS=2000

# --- SearXNG (Web Search) ---
# The web_search skill uses a local SearXNG instance for metasearch.
# Defaults work out of the box with docker compose.
SEARXNG_URL=http://searxng:8080
# Comma-separated categories: general, news, images, videos, it, science
# Default: general. Set to "all" to search all categories.
SEARXNG_CATEGORIES=general
# Maximum results per search query
SEARXNG_MAX_RESULTS=5
# Secret key for SearXNG (auto-generated if empty, set for persistent sessions)
SEARXNG_SECRET=