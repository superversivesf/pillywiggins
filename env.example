# Pillywiggins Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- PostgreSQL ---
DATABASE_URL=postgresql://pillywiggins:changeme@postgres:5432/pillywiggins
PG_PASSWORD=changeme

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- NATS ---
NATS_URL=nats://nats:4222

# --- LLM Provider ---
# Set LLM_PROVIDER to "ollama" or "openai"
#
# Option A: Local/self-hosted Ollama (no API key needed)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
MODEL_NAME=qwen3.5:8b
EMBEDDING_MODEL=nomic-embed-text

# Option B: Ollama Cloud (requires API key from ollama.com/settings/keys)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=https://ollama.com
# LLM_API_KEY=your_ollama_api_key
# MODEL_NAME=qwen3.5:9b

# Option C: Any OpenAI-compatible API (OpenAI, Groq, Together, etc.)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_api_key

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Agent Identity ---
AGENT_ID=puck
CHANNEL=telegram
PERSONALITY_FILE=/config/telegram.yaml